@implements IDisposable

@inject NavigationManager NavigationManager


<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="">GBC</a>

        @* <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button> *@

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                @foreach(var menu in MenuItems)
                {
                    if (menu.Dropdown != null && menu.Dropdown.Count > 0)
                    {
                        <li class="nav-item dropdown">
                            <NavLink class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrWhiteSpace(menu.IconClass))
                                {
                                    <span class="@menu.IconClass" aria-hidden="true"></span>
                                }
                                @menu.Title
                            </NavLink>
                            <ul class="dropdown-menu">
                                @foreach (var subMenu in menu.Dropdown)
                                {
                                    <li class="nav-item">
                                        <NavLink class="dropdown-item" href="@subMenu.Url">
                                            @if (!string.IsNullOrWhiteSpace(subMenu.IconClass))
                                            {
                                                <span class="@subMenu.IconClass" aria-hidden="true"></span>
                                            }
                                            @subMenu.Title
                                        </NavLink>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <NavLink class="@(menu.IsDisabled ? "nav-link disabled" : "nav-link")" href="@menu.Url" Match="@((menu.Url == "") ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                @if (!string.IsNullOrWhiteSpace(menu.IconClass))
                                {
                                    <span class="@menu.IconClass" aria-hidden="true"></span>
                                }
                                @menu.Title
                            </NavLink>
                        </li>
                    }
                }                
            </ul>
            <div>
                <form class="d-flex" role="search">
                    <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" />
                    <button class="btn btn-outline-success" type="submit">Search</button>
                </form>
            </div>
            @if(ShowTheme)
            {
                <ThemeControl CurrentTheme="@currentTheme" IsDarkTheme="@IsDarkTheme" IsDarkThemeChanged="@IsDarkThemeChanged" />
            }
        </div>
    </div>
</nav>

@code {

    List<MenuItem> menuList = new List<MenuItem>
    {
        new MenuItem { Title = "Home", Url = "", IconClass = Icons.Home },
        new MenuItem { Title = "Counter", Url = "counter", IconClass = Icons.Counter },
        new MenuItem { Title = "Weather", Url = "weather", IconClass = Icons.Weather },
        new MenuItem { Title = "Account", Url = null, IconClass = Icons.Account,
            Dropdown = new List<MenuItem>
            {
                new MenuItem { Title = "Login", Url = "Account/Login", IconClass = Icons.Login },
                new MenuItem { Title = "External Login", Url = "Account/Login", IconClass = Icons.Login },
                new MenuItem { Title = "Register", Url = "Account/Register", IconClass = Icons.Register }
            }   
        },
                new MenuItem { Title = "Disabled", Url = "disabled", IsDisabled=true },
    };



    [Parameter]
    public IReadOnlyList<MenuItem> MenuItems { get; set; } = default!;

    [Parameter]
    public bool ShowTheme { get; set; } = true;
    [Parameter]
    public bool IsDarkTheme { get; set; } = false;
    [Parameter]
    public EventCallback<bool> IsDarkThemeChanged { get; set; }

    string currentTheme = "dark";

    private string? currentUrl;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (MenuItems == null || MenuItems.Count == 0)
        {
            MenuItems = menuList;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }



    public class Icons
    {
        public const string Home = "bi bi-house-door-fill-nav-menu";
        public const string Counter = "bi bi-plus-square-fill-nav-menu";
        public const string Weather = "bi bi-list-nested-nav-menu";
        public const string Account = "bi bi-person-nav-menu";
        public const string Login = "bi bi-person-badge-nav-menu";
        public const string Register = "bi bi-person-nav-menu";
    }

    public class MenuItem
    {
        public string Title { get; internal set; } = string.Empty;
        public string? Url { get; internal set; }
        public string? IconClass { get; internal set; }
        public List<MenuItem>? Dropdown { get; internal set; }
        public bool IsDisabled { get; internal set; }
    }

}