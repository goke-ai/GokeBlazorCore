@inherits LayoutComponentBase
@using Goke.Blazor.Components.Models

<div class="page">
    <input type="checkbox" title="Navigation menu" class="navbar-toggler-main" />
    <div class="sidebar">
        <NavMenu AdditionalMenuLinks="AdditionalMenuLinks"
                 AdditionalMenuItems="AdditionalMenuItems"
                 CurrentTheme="@CurrentTheme"
                 IsDarkTheme="@IsDarkTheme"
                 IsDarkThemeChanged="@IsDarkThemeChanged" />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Parameter]
    public IReadOnlyList<NavMenuItem>? AdditionalMenuLinks { get; set; }

    [Parameter]
    public RenderFragment? AdditionalMenuItems { get; set; }

    [Parameter]
    public string CurrentTheme { get; set; } = "dark";

    [Parameter]
    public bool IsDarkTheme { get; set; }

    [Parameter]
    public EventCallback<bool> IsDarkThemeChanged { get; set; }
}