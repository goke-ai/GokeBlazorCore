@inherits LayoutComponentBase
@using Goke.Blazor.Components.Models

<div class="page">
    <input type="checkbox" title="Navigation menu" class="navbar-toggler-main" />
    <div class="sidebar">
        <NavMenu BrandContent="BrandContent"
                 AdditionalMenuLinks="AdditionalMenuLinks"
                 AdditionalMenuItems="AdditionalMenuItems"
                 OtherMenuItems="OtherMenuItems"
                 NavMenuEndItems="NavMenuEndItems" />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Parameter]
    public RenderFragment? BrandContent { get; set; }

    [Parameter]
    public IReadOnlyList<NavMenuItem>? AdditionalMenuLinks { get; set; }

    [Parameter]
    public RenderFragment? AdditionalMenuItems { get; set; }

    [Parameter]
    public RenderFragment? OtherMenuItems { get; set; }
    
    [Parameter]
    public RenderFragment? NavMenuEndItems { get; set; }    
   
}